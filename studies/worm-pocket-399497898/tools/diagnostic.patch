+/* DIAGNOSTIC ONLY (cemetery analysis, not a measured build): full map at stop. */
+static void diag_map_dump(void)
+{
+	const char *path = getenv("BORGH_MAPDUMP");
+	FILE *fp;
+	int x, y;
+	if (!path || !cave || !player) return;
+	fp = fopen(path, "w");
+	if (!fp) return;
+	fprintf(fp, "turn %ld depth %d player %d,%d hp %d/%d num_repro %d max %d poison %d sp %d dead %d\n",
+		(long)turn, player->depth, player->grid.y, player->grid.x,
+		player->chp, player->mhp, cave->num_repro, z_info->repro_monster_max,
+		player->timed[TMD_POISONED], player->csp, player->is_dead ? 1 : 0);
+	for (int pass = 0; pass < 2; pass++) {
+		fprintf(fp, pass ? "KNOWN\n" : "TRUTH\n");
+		for (y = 0; y < cave->height; y++) {
+			for (x = 0; x < cave->width; x++) {
+				struct loc g = loc(x, y);
+				struct chunk *c = pass ? player->cave : cave;
+				char ch = ' ';
+				struct monster *m = square_monster(cave, g);
+				if (pass && !square_isknown(cave, g)) { fputc(' ', fp); continue; }
+				if (square_isupstairs(c, g)) ch = '<';
+				else if (square_isdownstairs(c, g)) ch = '>';
+				else if (square_iscloseddoor(c, g)) ch = '+';
+				else if (square_isopendoor(c, g)) ch = '\'';
+				else if (square_isrubble(c, g)) ch = ':';
+				else if (square_ispassable(c, g)) ch = square_isroom(cave, g) ? ',' : '.';
+				else ch = '#';
+				if (m && m->race && (!pass || monster_is_visible(m))) {
+					ch = strstr(m->race->name, "worm") ? 'w' : 'M';
+				}
+				if (loc_eq(g, player->grid)) ch = '@';
+				fputc(ch, fp);
+			}
+			fputc('\n', fp);
+		}
+	}
+	{
+		struct object *obj;
+		char ob[160];
+		for (obj = player->gear; obj; obj = obj->next) {
+			object_desc(ob, sizeof(ob), obj, ODESC_PREFIX | ODESC_FULL, player);
+			fprintf(fp, "GEAR %c %s [%s]\n", object_is_equipped(player->body, obj) ? '=' : gear_to_label(player, obj), ob, obj->kind ? obj->kind->name : "?");
+		}
+	}
+	for (int i = 1; i < cave_monster_max(cave); i++) {
+		struct monster *m = cave_monster(cave, i);
+		if (!m || !m->race) continue;
+		fprintf(fp, "MON %d,%d %s hp %d\n", m->grid.y, m->grid.x, m->race->name, m->hp);
+	}
+	fclose(fp);
+}
