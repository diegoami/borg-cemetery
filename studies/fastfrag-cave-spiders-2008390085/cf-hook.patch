diff --git a/borg-core/src/cf_hook.rs b/borg-core/src/cf_hook.rs
new file mode 100644
index 00000000..bff8e448
--- /dev/null
+++ b/borg-core/src/cf_hook.rs
@@ -0,0 +1,29 @@
+//! LOCAL COUNTERFACTUAL HOOK, never committed.
+use crate::state::BorgState;
+use std::sync::Mutex;
+static PENDING: Mutex<Option<Vec<(i32, String)>>> = Mutex::new(None);
+fn load() -> Vec<(i32, String)> {
+    std::env::var("BORG_CF").unwrap_or_default().split(',').filter(|s| !s.is_empty())
+        .map(|s| { let (t, a) = s.split_once(':').unwrap(); (t.parse().unwrap(), a.to_string()) }).collect()
+}
+pub(crate) fn unbanned() -> bool {
+    std::env::var("BORG_CF_UNBAN").ok().and_then(|v| v.parse::<i32>().ok()).is_some_and(|t| crate::engine::game_turn() >= t)
+}
+pub(crate) fn fire(st: &mut BorgState) -> bool {
+    let mut g = PENDING.lock().unwrap();
+    if g.is_none() { *g = Some(load()); }
+    let list = g.as_mut().unwrap();
+    let now = crate::engine::game_turn();
+    let Some(pos) = list.iter().position(|(t, _)| now >= *t) else { return false };
+    let (t, a) = list.remove(pos);
+    let v = st.item_val;
+    let ok = match a.as_str() {
+        "speed" => crate::borg_item_use::borg_quaff_potion(st, v.sv_potion_speed),
+        "clw" => crate::borg_item_use::borg_quaff_potion(st, v.sv_potion_cure_light),
+        "csw" => crate::borg_item_use::borg_quaff_potion(st, v.sv_potion_cure_serious),
+        "phase" => crate::borg_item_use::borg_read_scroll(st, v.sv_scroll_phase_door),
+        _ => false,
+    };
+    crate::borg_io::borg_note(st, &format!("# CF hook: {a} at turn {now} (asked {t}): {}", if ok { "done" } else { "FAILED" }));
+    ok
+}
