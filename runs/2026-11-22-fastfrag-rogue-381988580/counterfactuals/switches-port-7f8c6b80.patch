+        let grouped = super::group_scaled_incoming(9.502, true, 100);
+        assert!(!super::wins_race_margin(3.0, grouped, 31, 0));
+        assert_eq!(super::group_scaled_incoming(9.502, false, 100), 9.502);
+    }
+}
